# OS / editor junk
.DS_Store
Thumbs.db

# Python & tooling (modules extend this per project)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# MkDocs build output
site/

# Session-local unlock tokens for the Decided-ADR edit lock (/unlock-adr,
# guard-adr.sh — ADR-0004/D-004). Machine state with a 1h read-time TTL:
# committing it would ship stale token state into every clone. The rest of
# .claude/working/ stays trackable (working docs may land on feature
# branches; /handoff archives them).
.claude/working/UNLOCKED_ADRS

# Local data staging: runs, bundles, checkpoints — never committed.
# Durable artifacts live in the external data repo (data-repo module / its ADR);
# this directory is a gitignored local staging area only.
data/*
!data/README.md

# Blueprint-only: this repo's OWN agent scratch stays untracked. /handoff moves
# working docs here (.claude/commands/handoff.md) and forbids deleting them, so
# committing the result ships blueprint-internal session notes — issue IDs,
# blueprint versions, citations to machinery BOOTSTRAP step 7 deletes — into
# every seeded project. README.md is the directory contract, so it stays.
# BLUEPRINT: delete this whole block — comment and both rules — at bootstrap.
# Seeded projects DO track their archive entries: HARVEST.md scans them from a
# clone, so ignoring them would make a project's own history invisible.
.claude/archive/*
!.claude/archive/README.md
